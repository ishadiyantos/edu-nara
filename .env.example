# Contoh env — copy ke .env dan sesuaikan sebelum menjalankan produksi.
# Fase 0 belum memakai env, tapi kita siapkan supaya Fase 1 tinggal jalan.

# Wajib sebelum production
SESSION_SECRET=change-me-to-a-32-byte-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Opsional
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/edu-nara.db
UPLOAD_DIR=./data/uploads
LOG_LEVEL=info
