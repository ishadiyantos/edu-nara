# Copy outside source/release; chmod 600. Never commit real values.
# Required on first startup only. No default admin credentials exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# At least 16 characters; generate privately. Existing accounts never reset on restart.

# Public externally visible origin. No trailing slash.
ORIGIN=https://edu.example.com
# Secure default, independent of NODE_ENV. HTTPS always uses Secure.
COOKIE_SECURE=true
# Structured application log level: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info
# ONLY for trusted local HTTP LAN: ORIGIN=http://10.200.10.5:3000
# and COOKIE_SECURE=false. HTTP exposes credentials on network; prefer HTTPS.

# Docker overrides DATABASE_PATH to /app/data/edu-nara.db.
# Bare-node default: ~/.local/share/edu-nara/edu-nara.db on LOCAL disk.
# Never place WAL DB on NFS/SMB.
# DATABASE_PATH=/local/disk/edu-nara.db
EDU_NARA_BIND_IP=127.0.0.1
# Deployment script sets image + absolute persistent data path.
# EDU_NARA_IMAGE=edu-nara:release-id
# EDU_NARA_DATA_DIR=/DATA/AppData/edu-nara/data
# Backup snapshots must use a separate persistent directory.
# EDU_NARA_BACKUP_DIR=/DATA/AppData/edu-nara/backups
# BACKUP_RETENTION_DAYS=30
# SESSION_RETENTION_DAYS=180
